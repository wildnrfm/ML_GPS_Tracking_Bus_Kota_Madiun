# ============================================================
#  .env.example — ML-ETA FastAPI Service
#  Salin file ini menjadi .env dan isi nilainya
#  cp .env.example .env
# ============================================================

# ── FastAPI Server ───────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8001
APP_ENV=local

# ── Generative AI (Groq) ────────────────────────────────────
# Dapatkan API key di: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# ── Laravel Backend URL (untuk CORS) ────────────────────────
LARAVEL_URL=http://localhost:8000

# ============================================================
#  .env.example — ML-ETA FastAPI Service
#  Salin file ini menjadi .env dan isi nilainya:
#  cp .env.example .env
# ============================================================

# ── FastAPI Server ───────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8001
APP_ENV=local

# ── HuggingFace & Monitoring (Required for Keep-Alive/Discord) ──
HF_SPACE_URL=https://your-username-space-name.hf.space
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_url_here
